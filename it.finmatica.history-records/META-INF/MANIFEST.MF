Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: History-records
Bundle-SymbolicName: it.finmatica.history-records;singleton:=true
Bundle-Version: 14.0.0.qualifier
Bundle-RequiredExecutionEnvironment: JavaSE-17
Bundle-ClassPath: .,
 lib/jsqlparser-idempiere.jar
Require-Bundle: org.adempiere.base;bundle-version="14.0.0",
 org.adempiere.plugin.utils;bundle-version="14.0.0",
 org.idempiere.acct;bundle-version="14.0.0",
 org.eclipse.osgi
Bundle-Activator: it.finmatica.history.records.activator.HistoryRecordsCoreActivator
Service-Component: OSGI-INF/historysqlrewriter.xml,OSGI-INF/hstprocessfactory.xml,OSGI-INF/historyevent.xml,
 OSGI-INF/hstmodelfactory.xml, OSGI-INF/historyvalidatorfactory.xml , OSGI-INF/historyuibehaviour.xml
Bundle-ActivationPolicy: lazy
Import-Package: org.osgi.service.event;version="1.3.0"
Export-Package: it.finmatica.history.records.model,
 it.finmatica.history.records.util
